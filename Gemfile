source "https://rubygems.org"

# Note: GitHub Pages production builds use the `github-pages` gem, which
# currently pins Jekyll 3.9 (circa 2018) and is incompatible with a modern
# Ruby's slimmed-down stdlib (missing csv/base64/bigdecimal/etc. as default
# gems). For local development we use a current Jekyll release instead —
# this validates templates/data/includes/theme rendering, but isn't a
# guarantee of byte-for-byte parity with GitHub's production build.
gem "jekyll"
gem "jekyll-theme-cayman"
gem "webrick"
